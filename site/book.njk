---
layout: base.njk
pagination:
  data: catalog.books
  size: 1
  alias: book
permalink: /book/{{ book.id }}/
eleventyComputed:
  title: "{{ book.title }}"
  description: "{{ (book.summary | truncate(160)) or ('A book by ' + book.author) }}"
---

{% block content %}
{% set doors = trail[book.id] %}

{% macro door(b, sub) %}
<li>
  <a class="door" href="/book/{{ b.id }}/">
    <span class="door__cover">{% if b.cover_url %}<img src="{{ b.cover_url }}" alt="" loading="lazy">{% endif %}</span>
    <span class="door__text">
      <span class="door__title">{{ b.title }}</span>
      <span class="door__sub">{{ sub }}</span>
    </span>
    {% if b.is_recommended %}<span class="door__star" title="Recommended">★</span>{% endif %}
  </a>
</li>
{% endmacro %}

<a href="/" class="back-link">← Catalog</a>

<div class="book-page">
  <article class="book-detail"
    data-book-id="{{ book.id }}"
    data-book-title="{{ book.title }}"
    data-book-author="{{ doors.author }}"
    data-book-cover="{{ book.cover_url or '' }}">

    <div class="book-detail__cover">
      {% if book.cover_url %}
        <img src="{{ book.cover_url }}" alt="Cover of {{ book.title }}">
      {% else %}
        <div class="book-cover book-cover--placeholder book-cover--large">
          <span class="book-cover__title">{{ book.title }}</span>
          <span class="book-cover__author">{{ book.author or "" }}</span>
        </div>
      {% endif %}
    </div>

    <div class="book-detail__main">
      <header class="book-detail__header">
        <h1 class="book-detail__title">{{ book.title }}</h1>
        {% if book.subtitle %}
          <p class="book-detail__subtitle">{{ book.subtitle }}</p>
        {% endif %}

        <p class="book-detail__author">
          {{ book.author or "Unknown author" }}
          {% if book.translator %}
            <span class="book-detail__translator">(translated by {{ book.translator }})</span>
          {% endif %}
        </p>

        {# One quiet line: recommendation, themes, when it was read. #}
        <p class="book-detail__meta">
          {%- if book.is_recommended %}<span class="star">★ Recommended</span>{% endif -%}
          {%- for themeSlug in book.themes -%}
            {%- for theme in catalog.themes -%}
              {%- if theme.slug == themeSlug %}<a href="/?theme={{ themeSlug }}" class="theme-tag">{{ theme.name }}</a>{% endif -%}
            {%- endfor -%}
          {%- endfor -%}
          {%- if book.date_read %}<span>read {{ book.date_read | readShort }}</span>
          {%- elif book.year_read %}<span>read {{ book.year_read }}</span>{% endif -%}
        </p>
      </header>

      {# Summary #}
      {% if book.summary or book.my_summary %}
        <div class="book-detail__summary">
          {{ book.my_summary or book.summary | safe }}
        </div>
      {% endif %}

      {# Personal notes #}
      {% if book.my_notes %}
        <div class="book-detail__notes">
          <h2 class="eyebrow">Notes</h2>
          {{ book.my_notes | safe }}
        </div>
      {% endif %}

      {# Publication details #}
      {% if book.year_published or book.original_year or book.series_name %}
        <dl class="book-detail__facts">
          {% if book.year_published %}
            <div class="meta-item">
              <dt>Published</dt>
              <dd>{{ book.year_published }}{% if book.publisher %} · {{ book.publisher }}{% endif %}</dd>
            </div>
          {% endif %}

          {% if book.original_year and book.original_year != book.year_published %}
            <div class="meta-item">
              <dt>Originally</dt>
              <dd>{{ book.original_year }}{% if book.original_language %} ({{ book.original_language }}){% endif %}</dd>
            </div>
          {% endif %}

          {% if book.series_name %}
            <div class="meta-item">
              <dt>Series</dt>
              <dd>{{ book.series_name }}{% if book.series_position %} (#{{ book.series_position }}){% endif %}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      {# Links #}
      {% if book.links and book.links.length > 0 %}
        <div class="book-detail__links">
          <h2 class="eyebrow">Links</h2>
          <ul class="links-list">
            {% for link in book.links %}
              <li>
                <a href="{{ link.url }}" target="_blank" rel="noopener">
                  {{ link.title or link.url }}
                  <span class="link-type">({{ link.type }})</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {# Leaps need the whole catalog, so they are script-only: hidden until
         /js/trail.js un-hides them. #}
      <p class="book-detail__leaps">
        <button type="button" class="text-button" data-leap="any" hidden>Leap anywhere</button>
        <button type="button" class="text-button" data-leap="recommended" hidden>Leap to a ★</button>
      </p>
    </div>
  </article>

  {# Doors: where to go next. Rendered at build time (see _data/trail.js). #}
  <aside class="doors" aria-label="Where next">
    {% if doors.before %}
      <section class="doors__group">
        <div class="doors__head"><h2 class="eyebrow">Read just before</h2></div>
        <ul class="doors__list">{{ door(doors.before, doors.before.author + " · " + (doors.before.date_read | readShort)) }}</ul>
      </section>
    {% endif %}

    {% if doors.after %}
      <section class="doors__group">
        <div class="doors__head"><h2 class="eyebrow">Read just after</h2></div>
        <ul class="doors__list">{{ door(doors.after, doors.after.author + " · " + (doors.after.date_read | readShort)) }}</ul>
      </section>
    {% endif %}

    {% if doors.sameAuthor.length %}
      <section class="doors__group">
        <div class="doors__head"><h2 class="eyebrow">More by {{ doors.author }}</h2></div>
        <ul class="doors__list">
          {% for b in doors.sameAuthor %}{{ door(b, ("read " + (b.date_read | readShort)) if b.date_read else b.author) }}{% endfor %}
        </ul>
      </section>
    {% endif %}

    {% if doors.shelf.length %}
      <section class="doors__group">
        <div class="doors__head">
          <h2 class="eyebrow">Also filed under {{ doors.theme.name }}</h2>
          <button type="button" class="text-button" data-reshuffle hidden>Reshuffle</button>
        </div>
        <ul class="doors__list" data-shelf="{{ doors.theme.slug }}">
          {% for b in doors.shelf %}{{ door(b, b.author) }}{% endfor %}
        </ul>
      </section>
    {% endif %}
  </aside>
</div>

{% include "trail.njk" %}
<script defer src="/js/trail.js"></script>
{% endblock %}
