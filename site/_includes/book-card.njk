{#
  Book card component

  Usage: {% include "book-card.njk" %}
  Expects: book object in scope

  The catalog page (index.njk) renders the same markup client-side with Alpine;
  keep the two in step. One set of classes serves both the cover grid and the
  list view: the container (.book-grid / .book-list) decides the layout.
#}

<a class="book-card" href="/book/{{ book.id }}/">
  <span class="book-card__cover">
    {% if book.cover_url %}
      <img src="{{ book.cover_url }}" alt="" loading="lazy">
    {% else %}
      <span class="book-card__placeholder">{{ book.title | truncate(40) }}</span>
    {% endif %}
  </span>
  <span class="book-card__info">
    <span class="book-card__title">{{ book.title }}</span>
    <span class="book-card__author">
      {%- if book.is_recommended %}<span class="star" title="Recommended">★</span> {% endif -%}
      {{ book.author or "Unknown author" }}
      {%- if book.translator %} <span class="book-card__translator">(trans. {{ book.translator }})</span>{% endif -%}
    </span>
  </span>
</a>
